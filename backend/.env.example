PORT=3000

# Allow your local frontends
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Use the same collections as prod (leave blank)
FS_NAMESPACE=

# If you used Option A (file path), leave this blank:
FIREBASE_SERVICE_ACCOUNT_BASE64=

# If you chose Option B (Base64), paste it here (single line, no quotes):
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXAiOiJKV1QiLCJhbGciOi...

# Keep real auth ON
DEV_BYPASS_AUTH=false
